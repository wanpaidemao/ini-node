+			if peers == nil {
+				peers = make(map[string]time.Time)
+				sm.frontUnreachable[rng.start] = peers
+			}
+			peers[peer.Addr()] = time.Now()
+			return
+		}
+		rng.headers = headers
+		rng.received = true
+		rng.confirmed = true
