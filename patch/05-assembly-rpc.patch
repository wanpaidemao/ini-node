+// handleStop implements the stop command.
+func handleStop(s *rpcServer, cmd interface{}, closeChan <-chan struct{}) (interface{}, error) {
+	select {
+	case s.requestProcessShutdown <- struct{}{}:
+	default:
+	}
+	return "btcd stopping.", nil
+}
