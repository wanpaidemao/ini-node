+func (b *BlockChain) writeLoadProgress(height, total int32) {
+	if b.sugarIndexDir == "" {
+		return
+	}
+	raw, err := json.Marshal(map[string]interface{}{
+		"phase":     "load",
+		"height":    height,
+		"total":     total,
